l Slice","HLOD","Performance Budget"],"refs":{"ch":24,"docs":["city-sample-pcg-for-unreal-engine"]},"req":["pcg"],"cap":1},{"id":"bpb","lane":"logic","t":2,"ic":"🔵","nm":"Blueprint căn bản","en":"Event · Node · Wire","d":"Event Graph, exec wire (trắng) vs data wire (màu), Event BeginPlay/Tick/Overlap, Cast, Print String — làm đồng xu tự xoay nhặt được.","terms":["Event Graph","Exec Pin","Cast","Blueprint Class"],"refs":{"ch":4,"docs":["blueprints-visual-scripting-in-unreal-engine","module-3-create-a-coin-pickup-with-modeling-tools-and-blueprints"]},"req":["editor"]},{"id":"bpvar","lane":"logic","t":3,"ic":"🔢","nm":"Variables & Branch","en":"Variables · Flow Control","d":"Biến (Instance Editable), Branch/Sequence/ForEach, timeline, giao tiếp giữa Blueprint qua Cast & Event Dispatcher.","terms":["Variable","Branch","Event Dispatcher","Timeline"],"refs":{"ch":4,"docs":["blueprint-variables-in-unreal-engine","blueprint-communications-in-unreal-engine"]},"req":["bpb"]},{"id":"collision","lane":"logic","t":4,"ic":"💥","nm":"Collision & Overlap","en":"Collision Presets","d":"Collision Presets, Object/Trace Channels, Hit vs Overlap events, physics runtime (Simulate, Impulse, Launch Character).","terms":["BlockAll","Overlap","Trace Channel","Simulate Physics"],"refs":{"ch":10,"docs":["collision-in-unreal-engine","physics-in-unreal-engine"]},"req":["bpvar"]},{"id":"bpfunc","lane":"logic","t":5,"ic":"🧩","nm":"Functions & Interfaces","en":"Functions · Interfaces","d":"Tổ chức code: Functions, Macro Libraries, Blueprint Interfaces, Blueprint Function Libraries — hết cảnh copy chuỗi node.","terms":["Function","Macro","Interface","Function Library"],"refs":{"ch":4,"docs":["blueprint-function-libraries-in-unreal-engine","implementing-blueprint-interfaces-in-unreal-engine"]},"req":["bpvar"]},{"id":"cpp","lane":"logic","t":6,"ic":"⌨️","nm":"C++ nhập môn","en":"C++ Basics · UPROPERTY","d":"Visual Studio workflow, UCLASS/UPROPERTY/UFUNCTION, expose C++ cho Blueprint, Live Coding. Quy tắ