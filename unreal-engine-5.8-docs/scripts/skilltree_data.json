{"nodes":[{"id":"install","lane":"core","t":1,"ic":"💾","nm":"Cài đặt & Project","en":"Install · Project Setup","d":"Cài Epic Games Launcher, engine 5.8, tạo project từ template (Third Person / First Person), hiểu Blueprint project vs C++ project.","terms":["Epic Games Launcher","Project","Template","Starter Content"],"refs":{"ch":1,"docs":["install-unreal-engine","module-1-install-ue-and-create-your-first-project"]}},{"id":"editor","lane":"core","t":2,"ic":"🧭","nm":"Điều hướng Editor","en":"Editor Interface","d":"Làm chủ Viewport (WASD + chuột phải), Content Browser, World Outliner, Details, Modes. Phân biệt Main Toolbar vs Viewport Toolbar.","terms":["Viewport","Content Browser","World Outliner","Details","Game View"],"refs":{"ch":2,"docs":["unreal-editor-interface","tools-and-editors-in-unreal-engine"]},"req":["install"]},{"id":"actor","lane":"core","t":3,"ic":"📦","nm":"Actor & Component","en":"Actor · Component · Transform","d":"Mọi thứ trong level là Actor; Actor ghép từ Component. Transform (Location/Rotation/Scale), Mobility Static vs Movable, Spawn/Destroy.","terms":["Actor","Component","Root Component","Transform","Mobility"],"refs":{"ch":3,"docs":["actors-in-unreal-engine","transforming-actors-in-unreal-engine"]},"req":["editor"]},{"id":"content","lane":"core","t":4,"ic":"📥","nm":"Content Pipeline","en":"Import · Interchange","d":"Nhập Static Mesh / Skeletal Mesh / Texture qua Interchange, chuẩn FBX/glTF (đơn vị cm, pivot, collision), naming convention SM_/SK_/T_/M_/MI_.","terms":["Static Mesh","Skeletal Mesh","Interchange","FBX","Naming Convention"],"refs":{"ch":5,"docs":["importing-assets-using-interchange-in-unreal-engine","importing-static-meshes-in-unreal-engine"]},"req":["actor"]},{"id":"blocking","lane":"world","t":2,"ic":"🧱","nm":"Dựng Level khối","en":"Blocking · Player Start","d":"Dựng phòng/khu chơi bằng cube + snap grid, đặt Player Start, đèn tạm, tư duy 4 lớp: geometry → lighting → gameplay → art pass.","terms":["Grid Snapping","Player Start","